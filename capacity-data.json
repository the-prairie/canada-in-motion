    "definitions": {
      "supply": "Eligible-to-practise registrants, including employed and not employed; secondary registrations excluded. First six months of registration year.",
      "inflow": "Registered in year t but not registered in the same jurisdiction in t\u22121; includes new graduates, migrants and returners.",
      "outflow": "Registered in year t but did not renew in same jurisdiction in t+1. Requires next-year data, so latest year is unavailable.",
      "renewal": "Registered in t and t\u22121.",
      "retention": "1\u2212outflow[t]/supply[t] is next-snapshot registration persistence, not employer retention."
    },
    "model": {
      "status": "conditional scenario; causal effects not estimated",
      "equation": "S[t+1] = max(0, S[t]*(1\u2212max(0,q\u2212retentionImprovementPP/100)) + I + extraEntrants[t+1\u2212delayYears])",
      "originYear": 2025,
      "originSupply": 44799,
      "baselineAnnualEntrants": 5575.666666666667,
      "baselineOutflowRate": 0.07082738084992857,
      "calibration": "Entrants average 2023\u20132025; outflow divided by supply, pooled 2022\u20132024. Includes registration-policy regime change; no evidence that this rate persists.",
      "controls": {
        "extraEntrantsPerYear": {
          "min": 0,
          "max": 3000,
          "default": 0,
          "unit": "additional RN registrants/year",
          "rationale": "Scenario range chosen for usability; not estimated recruitment capacity. Historical total entrants ranged 2390\u20137783."
        },
        "retentionImprovementPP": {
          "min": 0,
          "max": 2,
          "default": 0,
          "unit": "percentage points less annual registration outflow",
          "rationale": "Illustrative sensitivity; cannot exceed baseline exit rate. No estimated program effect."
        },
        "delayYears": {
          "min": 0,
          "max": 3,
          "default": 1,
          "unit": "years to realize extra registrations",
          "rationale": "Explicit assumption, not an estimated lag; 0 allows immediate registrations, 1\u20133 explores delay."
        }
      },
      "constraints": [
        "Never label registration entrants as hires or registration supply as hospital staffing.",
        "Do not convert to staffed beds, surgeries, school capacity, wait times or dollars.",
        "Separate new registrations from starting work; eligibility is necessary but insufficient.",
        "Do not assume migration, pay, funding or recruitment policy causes a chosen scenario gain."
      ]
    },
