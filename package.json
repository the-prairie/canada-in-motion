{
  "name": "canada-in-motion",
  "version": "2.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node scripts/serve-public.mjs",
    "preview": "node scripts/serve-public.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:workspace && node scripts/build-public.mjs",
    "gate:public": "node scripts/release-gate.mjs",
    "refresh": "python3 pipeline/refresh.py",
    "readiness:beta": "node scripts/launch-readiness.mjs",
    "start:ai": "node server/server.mjs",
    "refresh:economy": "python3 pipeline/refresh_economy.py",
    "build:ai": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy:ai": "wrangler deploy",
    "dev:ai:edge": "wrangler dev --local --port 8787",
    "test:ai:edge": "npm run build:ai && node --test tests/edge/*.test.mjs",
    "build:workspace": "node scripts/build-workspace.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@openuidev/react-lang": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  }
}
